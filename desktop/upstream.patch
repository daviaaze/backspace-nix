@@ -0,0 +1,96 @@
+<!doctype html>
+<html lang="pt-BR">
+<head>
+  <meta charset="UTF-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Compartilhar áudio</title>
+  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline';">
+  <style>
+    :root { color-scheme: light dark; font: 14px system-ui, sans-serif; }
+    body { margin: 0; padding: 24px; }
+    h1 { margin: 0 0 6px; font-size: 20px; }
+    p { margin: 0 0 16px; opacity: .75; }
+    #sources { max-height: 310px; overflow: auto; }
+    .source { display: flex; gap: 10px; padding: 11px 8px; border-bottom: 1px solid #8884; cursor: pointer; }
+    .source input { margin: 2px 0 0; }
+    .details { min-width: 0; }
+    .name, .application { overflow-wrap: anywhere; }
+    .application { opacity: .7; font-size: 12px; }
+    #empty { padding: 18px 8px; opacity: .75; }
+    footer { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; margin-top: 20px; }
+    button { padding: 8px 12px; }
+  </style>
+</head>
+<body>
+  <h1>Compartilhar áudio</h1>
+  <p>Escolha os aplicativos cujo áudio deseja compartilhar.</p>
+  <div id="sources" aria-live="polite"></div>
+  <div id="empty" hidden>Nenhum aplicativo reproduzindo áudio. Comece a reprodução e clique em Atualizar.</div>
+  <footer>
+    <button id="refresh" type="button">Atualizar</button>
+    <button id="selected" type="button">Compartilhar selecionados</button>
+    <button id="all" type="button">Todo áudio (menos Backspace)</button>
+    <button id="cancel" type="button">Cancelar</button>
+  </footer>
+  <script>
+    const api = window.audioSourcePicker;
+    const sourcesEl = document.getElementById('sources');
+    const emptyEl = document.getElementById('empty');
+    const selectedButton = document.getElementById('selected');
+    let busy = false;
+
+    async function refresh() {
+      if (busy) return;
+      const previous = new Set([...sourcesEl.querySelectorAll('input:checked')].map((input) => input.value));
+      sourcesEl.replaceChildren();
+      try {
+        const sources = await api.list();
+        emptyEl.hidden = sources.length !== 0;
+        emptyEl.textContent = sources.length ? '' : 'Nenhum aplicativo reproduzindo áudio. Comece a reprodução e clique em Atualizar.';
+        for (const source of sources) {
+          const label = document.createElement('label');
+          label.className = 'source';
+          const checkbox = document.createElement('input');
+          checkbox.type = 'checkbox';
+          checkbox.value = source.id;
+          checkbox.checked = previous.has(source.id);
+          const details = document.createElement('span');
+          details.className = 'details';
+          const name = document.createElement('span');
+          name.className = 'name';
+          name.textContent = source.name;
+          const application = document.createElement('span');
+          application.className = 'application';
+          application.textContent = source.application;
+          details.append(name, document.createElement('br'), application);
+          label.append(checkbox, details);
+          sourcesEl.append(label);
+        }
+        emptyEl.hidden = sources.length !== 0;
+      } catch {
+        emptyEl.hidden = false;
+        emptyEl.textContent = 'Não foi possível carregar os aplicativos. Tente Atualizar.';
+      }
+      selectedButton.disabled = sourcesEl.querySelectorAll('input:checked').length === 0;
+    }
+
+    sourcesEl.addEventListener('change', () => {
+      selectedButton.disabled = sourcesEl.querySelectorAll('input:checked').length === 0;
+    });
+    document.getElementById('refresh').addEventListener('click', refresh);
+    selectedButton.addEventListener('click', async () => {
+      const sourceIds = [...sourcesEl.querySelectorAll('input:checked')].map((input) => input.value);
+      if (sourceIds.length) {
+        busy = true;
+        await api.select(sourceIds);
+      }
+    });
+    document.getElementById('all').addEventListener('click', async () => {
+      busy = true;
+      await api.all();
+    });
+    document.getElementById('cancel').addEventListener('click', () => api.cancel());
+    refresh();
+  </script>
+</body>
+</html>
